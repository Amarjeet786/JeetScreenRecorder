<Window x:Class="JeetScreenRecorder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeet Screen Recorder" Width="780" Height="720" MinWidth="680" MinHeight="660"
        Background="#12141A" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14" HorizontalAlignment="Center">
            <TextBlock Text="Jeet Screen Recorder" Foreground="White" FontSize="22"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Created by Amarjeet K Gupta  •  WhatsApp: 8707018073"
                       Foreground="#9AA3B2" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C1F27" CornerRadius="16" Padding="28">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="#9AA3B2" FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TimerText}" Foreground="White" FontSize="60"
                           FontWeight="Light" HorizontalAlignment="Center" Margin="0,6,0,18"/>

                <Button Content="● Start Recording" Command="{Binding StartCommand}"
                        Style="{StaticResource BigButton}" Background="#E5484D" FontSize="20"
                        Padding="40,18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}"
                            Style="{StaticResource BigButton}" Background="#3B82F6"/>
                    <Button Content="■ Stop" Command="{Binding StopCommand}"
                            Style="{StaticResource BigButton}" Background="#4B5563"/>
                </StackPanel>

                <TextBlock Text="{Binding StatsText}" Foreground="#D1D5DB" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="560" Margin="0,18,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding CanEditSettings}">
                    <TextBlock Text="FPS" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" Width="90"/>
                    <TextBlock Text="Resolution" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" Width="130"/>
                </StackPanel>

                <TextBlock Text="{Binding EncoderText}" Foreground="#9AA3B2" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding OutputText}" Foreground="#6B7280" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="560"/>

                <TextBlock Text="{Binding Message}" Foreground="#FBBF24" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="560" Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="📁 Open recordings folder" Command="{Binding OpenFolderCommand}"
                        Style="{StaticResource BigButton}" Background="#2A2F3A" FontSize="13"
                        Padding="16,8" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Created by Amarjeet K Gupta  •  WhatsApp: 8707018073"
                       Foreground="#9AA3B2" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="🔒 Your recordings remain on your computer."
                       Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</Window>
